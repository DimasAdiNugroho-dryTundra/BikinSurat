# ==============================================================================
# BikinSurat - Git Ignore Rules
# Menjaga kerahasiaan data, berkas sensitif, artefak build, dan dokumen internal
# ==============================================================================

# --- Dokumen Internal & Spesifikasi ---
PRD.md
prd.md
PRD*.md
*.prd.md
*.PRD.md

# --- Basis Data Lokal & Data Sensitif ---
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
basisdata_bikinsurat.db
*.db.backup

# --- Kredensial, Sertifikat, Kunci Privat & Token ---
*.env
*.env.*
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local
*.key
*.pem
*.crt
*.cert
*.pfx
*.p12
*.keystore
*.jks
id_rsa*
id_ed25519*

# --- Frontend & Node.js Artifacts ---
node_modules/
dist/
dist-ssr/
*.tsbuildinfo
.vite/
.npm
.eslintcache
.parcel-cache

# --- Rust & Tauri Backend Build Output ---
target/
src-tauri/target/
**/*.rs.bk

# --- Logs & Debug Outputs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Temporary & Scratch Files ---
scratch/
tmp/
temp/
*.tmp
*.bak
*.swp
*.swo

# --- Sistem Operasi & Editor Konfigurasi ---
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini

# IDE & Text Editors
.idea/
.vscode/*
!.vscode/extensions.json
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.user

